<?xml version="1.0" encoding="utf-8"?>
<!-- Le contrat du service : ce que SOAP impose et que REST n'exige pas. -->
<definitions name="HttpTounsiCodes"
    targetNamespace="urn:http-tounsi:codes"
    xmlns="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:tns="urn:http-tounsi:codes"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <types>
    <xsd:schema targetNamespace="urn:http-tounsi:codes" elementFormDefault="qualified">
      <xsd:element name="GetCode">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="Code" type="xsd:int"/>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
      <xsd:element name="GetCodeResponse">
        <xsd:complexType><xsd:sequence>
          <xsd:element name="StatusCode">
            <xsd:complexType><xsd:sequence>
              <xsd:element name="Code" type="xsd:int"/>
              <xsd:element name="NomOfficiel" type="xsd:string"/>
              <xsd:element name="TitreDerja" type="xsd:string"/>
              <xsd:element name="Situation" type="xsd:string"/>
              <xsd:element name="ExplicationTechnique" type="xsd:string"/>
              <xsd:element name="Famille" type="xsd:string"/>
              <xsd:element name="ImageUrl" type="xsd:string"/>
            </xsd:sequence></xsd:complexType>
          </xsd:element>
        </xsd:sequence></xsd:complexType>
      </xsd:element>
    </xsd:schema>
  </types>
  <message name="GetCodeInput"><part name="parameters" element="tns:GetCode"/></message>
  <message name="GetCodeOutput"><part name="parameters" element="tns:GetCodeResponse"/></message>
  <portType name="CodesPortType">
    <operation name="GetCode">
      <input message="tns:GetCodeInput"/>
      <output message="tns:GetCodeOutput"/>
    </operation>
  </portType>
  <binding name="CodesBinding" type="tns:CodesPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="GetCode">
      <soap:operation soapAction="urn:http-tounsi:codes#GetCode"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
  </binding>
  <service name="CodesService">
    <port name="CodesPort" binding="tns:CodesBinding">
      <soap:address location="{{ url }}"/>
    </port>
  </service>
</definitions>
